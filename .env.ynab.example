# Copy to .env.ynab.local and fill local values. This file is ignored by git.

# OpenAI Secure MCP Tunnel for the separate YNAB service.
CONTROL_PLANE_TUNNEL_ID=tunnel_...
CONTROL_PLANE_API_KEY=

# Required YNAB provider credential. Keep it private.
YNAB_TOKEN=

# Optional private, absolute export root. The gateway creates it on first use.
YNAB_EXPORT_ROOT="/absolute/path/to/ynab-exports"

# Shared gateway binary installed by `make release`.
GATEWAY_BIN="$HOME/.local/bin/personal-mcp-gateway"

# Optional YNAB-local runtime paths and tunnel-client knobs.
MCP_GATEWAY_STATE_DIR=
MCP_GATEWAY_TELEMETRY_DB=
TUNNEL_HEALTH_LISTEN_ADDR=127.0.0.1:0
TUNNEL_LOG_FORMAT=json
